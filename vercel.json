{
  "version": 2,
  "framework": null,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/vendor",
      "destination": "/vendor.html"
    },
    {
      "source": "/rider",
      "destination": "/rider.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/partner",
      "destination": "/partner.html"
    },
    {
      "source": "/",
      "destination": "/customer.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}